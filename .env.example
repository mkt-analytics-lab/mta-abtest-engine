# Copy to `.env` (git-ignored) and adjust. Every variable is optional.
APP_CONFIG_PATH=configs/config.yaml
APP_MODEL_PATH=models/model.joblib
APP_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
APP_LOG_LEVEL=INFO

# Google Cloud project that runs BigQuery jobs (yours, with billing enabled).
# Authentication uses Application Default Credentials, never a key file:
#   gcloud auth application-default login
APP_GCP_PROJECT_ID=your-gcp-project-id
